          "type": "integer"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Request Id",
          "type": "string"
        },
        "printer_id": {
          "format": "uuid",
          "title": "Printer Id",
          "type": "string"
        },
        "source_epoch": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
          "title": "Source Epoch",
          "type": "string"
        },
        "sequence": {
          "maximum": 1000000000000,
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "kind": {
          "const": "error",
          "title": "Kind",
          "type": "string"
        },
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:-]+$",
